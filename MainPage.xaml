<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ytdlp_gui.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Entry
                x:Name="UrlEntry"
                Placeholder="Enter Youtube URL"
                />

            <Button
                x:Name="DownloadBtn"
                Text="Download" 
                SemanticProperties.Hint="Start the download process"
                Clicked="OnStartDownloadClicked"
                HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
